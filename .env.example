# ==============================================================================
# Environment Configuration for Fuel-Efficient Route Planner API
# ==============================================================================

# Security & Django settings
DEBUG=True
SECRET_KEY=django-insecure-spotter-fuel-route-planner-assessment-key-change-in-prod
ALLOWED_HOSTS=*
CORS_ALLOW_ALL_ORIGINS=True

# Routing & Geocoding Services
OSRM_BASE_URL=http://router.project-osrm.org
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=SpotterFuelRoutePlanner/1.0

# Data file paths (relative to project root or absolute paths)
FUEL_DATA_PATH=data/fuel-prices.csv
US_CITIES_PATH=data/us_cities.csv

# Vehicle & Optimization Parameters
MAX_VEHICLE_RANGE_MILES=500
FUEL_EFFICIENCY_MPG=10
MAX_STATION_DISTANCE_FROM_ROUTE_MILES=15

# Cache TTL in seconds (24 hours)
CACHE_TTL_SECONDS=86400
